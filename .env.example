# XTREN CMS Configuration Environment Variables

# Public Site URL (Used for generating dynamic Open Graph cards & Telegram links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Cloud Firestore (Web SDK credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Telegram Bot API Configuration (Can also be set directly in Admin Dashboard UI)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id

# Twitter / X OAuth 2.0 PKCE & API v2
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# Twitter / X API v1.1 / v2 Direct Posting Credentials (Optional alternative)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret
